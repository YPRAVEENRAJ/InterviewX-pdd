    <Cell ss:StyleID="FailCell"><Data ss:Type="String">4870 ms</Data></Cell>
    <Cell ss:StyleID="MetricLabel"><Data ss:Type="String">Virtual Users</Data></Cell>
    <Cell ss:StyleID="MetricValue"><Data ss:Type="Number">500</Data></Cell>
   </Row>

   <!-- PERCENTILE METRICS ROW -->
